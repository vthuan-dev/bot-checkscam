[Unit]
Description=CheckScam Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bot-checkscam/telegram-bot
ExecStart=/usr/bin/node bot.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=checkscam-bot

[Install]
WantedBy=multi-user.target